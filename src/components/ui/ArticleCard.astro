---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const slug = article.id.replace(/\.md$/, '');
---

<a href={`/articles/${slug}`} class="article-card" data-source={article.data.source}>
  <div class="article-card-inner">
    <div class="article-icon">
      <span class="article-icon-symbol">📝</span>
    </div>
    <div class="article-info">
      <h3 class="article-title">{article.data.title}</h3>
      <p class="article-date">
        {new Date(article.data.date).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <p class="article-description">{article.data.description}</p>
      {article.data.tags && article.data.tags.length > 0 && (
        <div class="article-tags">
          {article.data.tags.slice(0, 3).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      <span class="article-link-hint">اطّلع على المقال →</span>
    </div>
  </div>
</a>

<style>
  .article-card {
    text-decoration: none;
    color: inherit;
    display: block;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    overflow: hidden;
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06);
    border-color: var(--color-accent);
  }

  .article-card-inner {
    display: flex;
    gap: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(1.25rem, 2vw, 2rem);
    align-items: flex-start;
  }

  .article-icon {
    flex-shrink: 0;
    width: clamp(3rem, 5vw, 4.5rem);
    height: clamp(3.5rem, 6vw, 5.5rem);
    background: #f0fdfa;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ccfbf1;
  }

  .article-icon-symbol {
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    line-height: 1;
  }

  .article-info {
    flex: 1;
    min-width: 0;
  }

  .article-title {
    font-family: var(--font-arabic-heading);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    color: var(--color-text);
    margin: 0 0 0.1rem 0;
    line-height: 1.4;
  }

  .article-card:hover .article-title {
    color: var(--color-accent-dark);
  }

  .article-date {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.8rem, 1.2vw, 0.9rem);
    color: var(--color-text-light);
    margin: 0 0 0.4rem 0;
  }

  .article-description {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    color: var(--color-text);
    line-height: 1.7;
    margin: 0 0 0.6rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }

  .article-tags .tag {
    font-family: var(--font-arabic-body);
    font-size: 0.7rem;
    background: #f0fdfa;
    color: var(--color-accent-dark);
    padding: 0.1rem 0.6rem;
    border-radius: 4px;
    border: 1px solid #ccfbf1;
  }

  .article-link-hint {
    font-family: var(--font-arabic-heading);
    font-size: clamp(0.8rem, 1vw, 0.9rem);
    color: var(--color-accent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
    display: inline-block;
  }

  .article-card:hover .article-link-hint {
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .article-card-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .article-icon {
      width: 2.5rem;
      height: 3rem;
    }

    .article-icon-symbol {
      font-size: 1.2rem;
    }
  }
</style>