---
interface RecItem {
  title: string;
  description: string;
  type: 'book' | 'software';
  link: string;
}
const recommendations: RecItem[] = [
  {
    title: 'بزوغ ضياء الفجر الوضاء',
    description: 'تفنيد الشبهات الفقهية حول التصوير الضوئي، في ستة أبواب محكمة.',
    type: 'book',
    link: '/books/bzugh'
  },
  {
    title: 'وهم الواقعية والانعكاس',
    description: 'مستل مفرد يناقش تفكيك القول بالانعكاس وإثبات صناعة الصورة رقمياً.',
    type: 'book',
    link: '/books/wahm'
  },
  {
    title: 'مكتبة الفجر الرقمية',
    description: 'منصة مفتوحة المصدر لإدارة المخطوطات والرسائل العلمية بنظام تصنيف متقدم.',
    type: 'software',
    link: 'https://github.com/'
  },
];
---
<section class="rec-section">
  <div class="container">
    <h2 class="rec-heading">ترشيحات وتوصيات نافعة</h2>
    <div class="rec-grid">
      {recommendations.map((item) => (
        <div class="rec-card">
          <div class="rec-type-badge" class:list={[item.type === 'book' ? 'badge-book' : 'badge-software']}>
            {item.type === 'book' ? '📘 كتاب نافع' : '🛠 برمجيات مفيدة'}
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <a href={item.link} class="rec-action">
            {item.type === 'book' ? 'مطالعة المادة الشرعية ←' : 'استعراض الأداة ←'}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .rec-section {
    padding: var(--space-lg) 0;
    background: var(--color-bg);
  }
  .rec-heading {
    font-family: var(--font-arabic-heading);
    font-size: 2rem;
    margin-bottom: var(--space-md);
    border-right: 4px solid var(--color-accent-dark);
    padding-right: var(--space-sm);
  }
  .rec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-md);
  }
  .rec-card {
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    padding: var(--space-md);
    transition: transform 0.2s, border-color 0.2s;
    display: flex;
    flex-direction: column;
  }
  .rec-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }
  .rec-type-badge {
    font-family: var(--font-arabic-heading);
    font-size: 0.8rem;
    padding: 0.2rem 0.8rem;
    border-radius: 12px;
    display: inline-block;
    align-self: flex-start;
    margin-bottom: var(--space-sm);
  }
  .badge-book {
    background: var(--color-accent-bg);
    color: var(--color-accent-dark);
  }
  .badge-software {
    background: #dcfce7;
    color: #15803d;
  }
  .rec-card h3 {
    font-family: var(--font-arabic-heading);
    font-size: 1.3rem;
    margin: 0 0 0.25rem;
  }
  .rec-card p {
    font-family: var(--font-arabic-body);
    font-size: 0.95rem;
    line-height: 1.6;
    flex: 1;
    margin-bottom: var(--space-sm);
  }
  .rec-action {
    font-family: var(--font-arabic-heading);
    font-weight: 700;
    text-decoration: none;
    color: var(--color-accent);
    border-bottom: 1px solid transparent;
    align-self: flex-start;
    transition: border-color 0.15s;
  }
  .rec-action:hover {
    border-bottom-color: var(--color-accent);
  }
</style>