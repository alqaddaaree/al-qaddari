---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  app: CollectionEntry<'apps'>;
}
const { app } = Astro.props;
const slug = app.id.replace(/\.md$/, '');

// Detect if app is English (check if title contains Arabic characters)
const isEnglish = !/[\u0600-\u06FF]/.test(app.data.title);
---

<a href={`/apps/${slug}`} class="app-card" data-category={app.data.category}>
  <div class="app-card-inner" dir={isEnglish ? 'ltr' : 'rtl'}>
    <div class="app-icon">
      <span class="app-icon-symbol">
        {app.data.type === 'pwa' ? '📱' : '🌐'}
      </span>
    </div>
    <div class="app-info">
      <h3 class="app-title" style={isEnglish ? 'text-align: left;' : ''}>{app.data.title}</h3>
      <p class="app-type" style={isEnglish ? 'text-align: left;' : ''}>
        {app.data.type === 'pwa' ? (isEnglish ? 'PWA App' : 'تطبيق PWA') : (isEnglish ? 'Website' : 'موقع إلكتروني')}
        {app.data.featured && <span class="featured-badge">{isEnglish ? 'Featured' : 'مميّز'}</span>}
      </p>
      <p class="app-description" style={isEnglish ? 'text-align: left;' : ''}>{app.data.description}</p>
      {app.data.tags && app.data.tags.length > 0 && (
        <div class="app-tags" style={isEnglish ? 'justify-content: flex-start;' : ''}>
          {app.data.tags.slice(0, 3).map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      <span class="app-link-hint">{isEnglish ? 'View App →' : 'اطّلع على التطبيق →'}</span>
    </div>
  </div>
</a>

<style>
  .app-card {
    text-decoration: none;
    color: inherit;
    display: block;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    overflow: hidden;
  }

  .app-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.06);
    border-color: var(--color-accent);
  }

  .app-card-inner {
    display: flex;
    gap: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(1.25rem, 2vw, 2rem);
    align-items: flex-start;
  }

  .app-icon {
    flex-shrink: 0;
    width: clamp(3rem, 5vw, 4.5rem);
    height: clamp(3.5rem, 6vw, 5.5rem);
    background: #f0fdfa;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ccfbf1;
  }

  .app-icon-symbol {
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    line-height: 1;
  }

  .app-info {
    flex: 1;
    min-width: 0;
  }

  .app-title {
    font-family: var(--font-arabic-heading);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    color: var(--color-text);
    margin: 0 0 0.1rem 0;
    line-height: 1.4;
  }

  .app-card:hover .app-title {
    color: var(--color-accent-dark);
  }

  .app-type {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.8rem, 1.2vw, 0.9rem);
    color: var(--color-text-light);
    margin: 0 0 0.4rem 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .featured-badge {
    font-size: 0.65rem;
    background: #fef3c7;
    color: #92400e;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #f59e0b;
  }

  .app-description {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    color: var(--color-text);
    line-height: 1.7;
    margin: 0 0 0.6rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .app-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }

  .app-tags .tag {
    font-family: var(--font-arabic-body);
    font-size: 0.7rem;
    background: #f0fdfa;
    color: var(--color-accent-dark);
    padding: 0.1rem 0.6rem;
    border-radius: 4px;
    border: 1px solid #ccfbf1;
  }

  .app-link-hint {
    font-family: var(--font-arabic-heading);
    font-size: clamp(0.8rem, 1vw, 0.9rem);
    color: var(--color-accent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
    display: inline-block;
  }

  .app-card:hover .app-link-hint {
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .app-card-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .app-icon {
      width: 2.5rem;
      height: 3rem;
    }

    .app-icon-symbol {
      font-size: 1.2rem;
    }
  }
</style>