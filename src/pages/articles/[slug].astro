---
import PageLayout from '../../components/layout/PageLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id.replace(/\.md$/, '') },
    props: { article },
  }));
}

const { article } = Astro.props as { article: CollectionEntry<'articles'> };

// Render the article content
const { Content, headings } = await render(article);

// Build dynamic share URLs
const siteUrl = import.meta.env.SITE || 'https://al-qaddari.com';
const pageUrl = `${siteUrl}/articles/${article.id.replace(/\.md$/, '')}`;
const shareText = `📝 ${article.data.title}`;

// Source display names
const sourceNames: Record<string, string> = {
  'armalqaddaaree': 'المدونة الشخصية (عربي)',
  'en-armalqaddaaree': 'المدونة الشخصية (إنجليزي)',
  'al-albaanee': 'مدونة الألباني',
  'scourgeofphotography': 'Scourge of Photography',
  'raqmanat': 'رقمنات',
  'islaamchildrenbooks': 'كتب إسلامية للأطفال',
};
---

<PageLayout title={`${article.data.title} — عبد الرحمن القداري`} description={article.data.description}>
  <div class="article-detail">
    <div class="article-detail-header">
      <a href="/articles" class="back-link">← العودة إلى قائمة المقالات</a>
    </div>

    <div class="article-detail-content">
      <div class="article-detail-main">
        <div class="article-meta">
          <h1 class="article-detail-title">{article.data.title}</h1>
          <div class="article-detail-info">
            <span class="article-detail-date">
              {new Date(article.data.date).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
            <span class="article-detail-source" data-source={article.data.source}>
              {sourceNames[article.data.source] || article.data.source}
            </span>
          </div>
          {article.data.tags && article.data.tags.length > 0 && (
            <div class="article-detail-tags">
              {article.data.tags.map((tag: string) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </div>

        <div class="article-detail-body">
          <article class="prose">
            <Content />
          </article>
        </div>

        {article.data.sourceUrl && (
          <div class="article-detail-source-link">
            <p>
              <span>📌 المصدر الأصلي: </span>
              <a href={article.data.sourceUrl} target="_blank" rel="noopener" class="source-link">
                {article.data.sourceUrl}
              </a>
            </p>
          </div>
        )}
      </div>

      <aside class="article-detail-sidebar">
        <div class="sidebar-card">
          <h3 class="sidebar-title">معلومات المقال</h3>
          <ul class="sidebar-info">
            <li>
              <span class="info-label">العنوان</span>
              <span class="info-value">{article.data.title}</span>
            </li>
            <li>
              <span class="info-label">التاريخ</span>
              <span class="info-value">{new Date(article.data.date).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </li>
            <li>
              <span class="info-label">المصدر</span>
              <span class="info-value">{sourceNames[article.data.source] || article.data.source}</span>
            </li>
            {article.data.tags && article.data.tags.length > 0 && (
              <li>
                <span class="info-label">الوسوم</span>
                <span class="info-value">{article.data.tags.join('، ')}</span>
              </li>
            )}
            <li>
              <span class="info-label">اللغة</span>
              <span class="info-value">{article.data.language === 'ar' ? 'العربية' : 'الإنجليزية'}</span>
            </li>
          </ul>
        </div>

        <div class="sidebar-card sidebar-card-share">
          <h3 class="sidebar-title">مشاركة</h3>
          <p class="sidebar-share-text">انشر هذا المقال لتعم الفائدة</p>
          <div class="share-links">
            <a href={`https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(shareText)}`} target="_blank" rel="noopener" class="share-link telegram">تيليجرام</a>
            <a href={`mailto:?subject=${encodeURIComponent(shareText)}&body=${encodeURIComponent('اطّلع على هذا المقال:\n' + pageUrl)}`} target="_blank" rel="noopener" class="share-link email">البريد الإلكتروني</a>
            <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + '\n' + pageUrl)}`} target="_blank" rel="noopener" class="share-link whatsapp">واتساب</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</PageLayout>

<style>
  /* ─── Scoped Styles ─── */
  .article-detail {
    max-width: 100%;
    margin: 0 auto;
  }

  .article-detail-header {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .back-link {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--color-accent-dark);
  }

  .article-detail-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .article-detail-main {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .article-detail-title {
    font-family: var(--font-arabic-heading);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    color: var(--color-accent-dark);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .article-detail-info {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .article-detail-date {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    color: var(--color-text-light);
  }

  .article-detail-source {
    font-family: var(--font-arabic-body);
    font-size: 0.7rem;
    padding: 0.1rem 0.6rem;
    border-radius: 4px;
    background: #f0fdfa;
    color: var(--color-accent-dark);
    border: 1px solid #ccfbf1;
  }

  .article-detail-source[data-source="al-albaanee"] {
    background: #fef3c7;
    border-color: #f59e0b;
    color: #92400e;
  }

  .article-detail-source[data-source="en-armalqaddaaree"] {
    background: #dbeafe;
    border-color: #60a5fa;
    color: #1e40af;
  }

  .article-detail-source[data-source="scourgeofphotography"] {
    background: #fce4ec;
    border-color: #ef5350;
    color: #b71c1c;
  }

  .article-detail-source[data-source="raqmanat"] {
    background: #e0f2fe;
    border-color: #38bdf8;
    color: #0e7490;
  }

  .article-detail-source[data-source="islaamchildrenbooks"] {
    background: #d1fae5;
    border-color: #34d399;
    color: #065f46;
  }

  .article-detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.2rem;
  }

  .article-detail-tags .tag {
    font-family: var(--font-arabic-body);
    font-size: 0.75rem;
    background: #f0fdfa;
    color: var(--color-accent-dark);
    padding: 0.1rem 0.7rem;
    border-radius: 4px;
    border: 1px solid #ccfbf1;
  }

  /* ─── Article Body (Markdown) ─── */
  .article-detail-body {
    font-family: var(--font-arabic-body);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 2;
    color: var(--color-text);
  }

  .article-detail-body .prose {
    direction: rtl;
    text-align: right;
  }

  /* ─── Headings ─── */
  .article-detail-body .prose h2,
  .article-detail-body .prose h3,
  .article-detail-body .prose h4 {
    font-family: var(--font-arabic-heading);
    color: var(--color-accent-dark);
    margin-top: 1.8rem;
    margin-bottom: 0.75rem;
  }

  .article-detail-body .prose h2 {
    font-size: clamp(1.3rem, 2vw, 1.7rem);
  }
  .article-detail-body .prose h3 {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
  }

  .article-detail-body .prose p {
    margin-bottom: 1rem;
  }

  /* ─── Blockquote ─── */
  .article-detail-body .prose blockquote {
    padding: 0.75rem 1.5rem;
    margin: 1rem 0;
    background: #f0fdfa;
    border-right: 4px solid var(--color-accent);
    border-radius: 0 4px 4px 0;
    color: var(--color-text-light);
    font-style: italic;
  }

  .article-detail-body .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .article-detail-body .prose a:hover {
    color: var(--color-accent-dark);
  }

  .article-detail-body .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1rem 0;
  }

  .article-detail-body .prose hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }

  .article-detail-body .prose strong {
    color: var(--color-accent-dark);
  }

  /* ─── Source Link ─── */
  .article-detail-source-link {
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
    padding-top: clamp(1rem, 2vw, 1.5rem);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-arabic-body);
    font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    color: var(--color-text-light);
  }

  .source-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    word-break: break-all;
  }

  .source-link:hover {
    color: var(--color-accent-dark);
  }

  /* ─── Sidebar ─── */
  .article-detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 2vw, 2rem);
  }

  .sidebar-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: clamp(1.25rem, 2vw, 1.75rem);
  }

  .sidebar-title {
    font-family: var(--font-arabic-heading);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--color-accent-dark);
    margin: 0 0 clamp(0.75rem, 1vw, 1rem) 0;
    border-bottom: 1px solid #e0f2f1;
    padding-bottom: 0.5rem;
  }

  .sidebar-info {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-info li {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    font-family: var(--font-arabic-body);
    font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    border-bottom: 1px solid #f3f4f6;
  }

  .sidebar-info li:last-child {
    border-bottom: none;
  }

  .info-label {
    color: var(--color-text-light);
    font-weight: 400;
  }

  .info-value {
    color: var(--color-text);
    font-weight: 500;
    text-align: left;
  }

  .sidebar-card-share {
    background: #f0fdfa;
    border-color: #ccfbf1;
  }

  .sidebar-share-text {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    color: var(--color-text-light);
    margin: 0 0 0.75rem 0;
  }

  .share-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .share-link {
    font-family: var(--font-arabic-heading);
    font-size: clamp(0.8rem, 1vw, 0.9rem);
    padding: 0.3rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .share-link:hover {
    opacity: 0.8;
  }

  .share-link.telegram {
    background: #0088cc;
    color: #ffffff;
  }

  .share-link.email {
    background: #6c757d;
    color: #ffffff;
  }

  .share-link.whatsapp {
    background: #25d366;
    color: #ffffff;
  }

  @media (max-width: 800px) {
    .article-detail-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .article-detail-sidebar {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .sidebar-card {
      flex: 1;
      min-width: 200px;
    }
  }

  @media (max-width: 600px) {
    .article-detail-main {
      padding: 1rem;
    }

    .article-detail-sidebar {
      flex-direction: column;
    }

    .sidebar-card {
      min-width: unset;
    }

    .prose blockquote {
      padding: 0.5rem 1rem;
    }
  }
</style>

<style is:global>
  /* ─── GLOBAL: Force list indentation for rendered markdown ─── */
  .article-detail-body .prose ul,
  .article-detail-body .prose ol {
    padding-right: 2rem !important;
    padding-left: 0 !important;
    margin: 0.75rem 0 !important;
    list-style-position: outside !important;
    list-style-type: disc !important;
  }

  .article-detail-body .prose ol {
    list-style-type: decimal !important;
  }

  .article-detail-body .prose ul ul,
  .article-detail-body .prose ol ol,
  .article-detail-body .prose ul ol,
  .article-detail-body .prose ol ul {
    padding-right: 2rem !important;
    padding-left: 0 !important;
    margin: 0.25rem 0 !important;
  }

  .article-detail-body .prose li {
    margin-bottom: 0.3rem;
    padding-right: 0.2rem;
  }

  .article-detail-body .prose li::marker {
    color: var(--color-accent-dark);
    font-weight: bold;
  }
</style>