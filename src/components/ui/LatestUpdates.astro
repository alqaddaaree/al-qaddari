---
// This will later accept props from collections
interface UpdateItem {
  title: string;
  type: 'book' | 'article' | 'misc';
  date: string;
  link: string;
}
const updates: UpdateItem[] = [
  { title: 'بزوغ ضياء الفجر الوضاء', type: 'book', date: '2025-06-01', link: '/books/bzugh' },
  { title: 'وهم الواقعية والانعكاس', type: 'book', date: '2025-05-20', link: '/books/wahm' },
  { title: 'من زهرة إلى زهرة', type: 'article', date: '2025-06-05', link: '/articles/zahra' },
];
// For now, we use static data; later we'll fetch from collections.
---
<section class="updates-section">
  <div class="container">
    <div class="updates-header">
      <h2>آخر المضافات والمستجدات</h2>
      <span class="accent-line"></span>
    </div>
    <div class="updates-feed">
      {updates.map((item) => (
        <div class="update-row">
          <span class="update-date">{item.date}</span>
          <span class={`update-badge badge-${item.type}`}>
            {item.type === 'book' ? 'كتب ورسائل' : item.type === 'article' ? 'مقالات وبحوث' : 'متفرقات'}
          </span>
          <a href={item.link} class="update-title">{item.title}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .updates-section {
    padding: var(--space-lg) 0;
    background-color: var(--color-bg-subtle);
  }
  .updates-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    border-right: 4px solid var(--color-accent-dark);
    padding-right: var(--space-sm);
  }
  .updates-header h2 {
    font-family: var(--font-arabic-heading);
    font-size: 1.8rem;
    margin: 0;
  }
  .accent-line {
    flex: 1;
    height: 2px;
    background: var(--color-accent);
    opacity: 0.4;
  }
  .updates-feed {
    background: var(--color-bg);
    border-radius: var(--card-radius);
    padding: var(--space-sm) var(--space-md);
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }
  .update-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .update-row:last-child {
    border-bottom: none;
  }
  .update-date {
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    color: var(--color-text-light);
    direction: ltr; /* date in English format */
    min-width: 80px;
  }
  .update-badge {
    font-family: var(--font-arabic-heading);
    font-size: 0.75rem;
    padding: 0.15rem 0.6rem;
    border-radius: 12px;
    background: var(--color-accent-bg);
    color: var(--color-accent-dark);
    white-space: nowrap;
  }
  .badge-article {
    background: #e0f2fe;
    color: #0369a1;
  }
  .badge-misc {
    background: #f3e8ff;
    color: #6b21a8;
  }
  .update-title {
    font-family: var(--font-arabic-body);
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--color-text);
    flex: 1;
  }
  .update-title:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .update-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .update-date {
      min-width: auto;
    }
  }
</style>