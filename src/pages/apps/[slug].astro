---
import PageLayout from '../../components/layout/PageLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { slug: app.id.replace(/\.md$/, '') },
    props: { app },
  }));
}

const { app } = Astro.props as { app: CollectionEntry<'apps'> };

// Build dynamic share URLs
const siteUrl = import.meta.env.SITE || 'https://al-qaddari.com';
const pageUrl = `${siteUrl}/apps/${app.id.replace(/\.md$/, '')}`;
const shareText = `📱 ${app.data.title}`;
---

<PageLayout title={`${app.data.title} — عبد الرحمن القداري`} description={app.data.description}>
  <div class="app-detail">
    <div class="app-detail-header">
      <a href="/apps" class="back-link">← العودة إلى قائمة التطبيقات</a>
    </div>

    <div class="app-detail-content">
      <div class="app-detail-main">
        <div class="app-detail-icon">
          {app.data.image ? (
            <img src={app.data.image} alt={app.data.title} class="app-icon-image" />
          ) : (
            <span class="app-detail-icon-symbol">
              {app.data.type === 'pwa' ? '📱' : '🌐'}
            </span>
          )}
        </div>

        <h1 class="app-detail-title">{app.data.title}</h1>
        <p class="app-detail-type">
          {app.data.type === 'pwa' ? 'تطبيق PWA' : 'موقع إلكتروني'}
          {app.data.featured && <span class="featured-badge">مميّز</span>}
        </p>

        <div class="app-detail-description">
          <p>{app.data.description}</p>
        </div>

        {app.data.tags && app.data.tags.length > 0 && (
          <div class="app-detail-tags">
            <span class="tags-label">الوسوم:</span>
            {app.data.tags.map((tag: string) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}

        {app.data.note && (
          <div class="app-detail-note">
            <p>{app.data.note}</p>
          </div>
        )}

        <div class="app-detail-action">
          <a href={app.data.url || '#'} target="_blank" rel="noopener noreferrer" class="visit-btn">
            <span class="visit-icon">🚀</span>
            زيارة التطبيق
          </a>
          <p class="visit-note">سيتم فتح الرابط في نافذة جديدة</p>
        </div>
      </div>

      <aside class="app-detail-sidebar">
        <div class="sidebar-card">
          <h3 class="sidebar-title">معلومات التطبيق</h3>
          <ul class="sidebar-info">
            <li>
              <span class="info-label">العنوان</span>
              <span class="info-value">{app.data.title}</span>
            </li>
            <li>
              <span class="info-label">النوع</span>
              <span class="info-value">{app.data.type === 'pwa' ? 'تطبيق PWA' : 'موقع إلكتروني'}</span>
            </li>
            <li>
              <span class="info-label">التصنيف</span>
              <span class="info-value">{app.data.category}</span>
            </li>
            {app.data.tags && app.data.tags.length > 0 && (
              <li>
                <span class="info-label">الوسوم</span>
                <span class="info-value">{app.data.tags.join('، ')}</span>
              </li>
            )}
            {app.data.featured && (
              <li>
                <span class="info-label">الحالة</span>
                <span class="info-value" style="color: #92400e; background: #fef3c7; padding: 0.1rem 0.6rem; border-radius: 4px;">مميّز</span>
              </li>
            )}
          </ul>
        </div>

        <div class="sidebar-card sidebar-card-share">
          <h3 class="sidebar-title">مشاركة</h3>
          <p class="sidebar-share-text">انشر هذا التطبيق لتعم الفائدة</p>
          <div class="share-links">
            <a href={`https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(shareText)}`} target="_blank" rel="noopener" class="share-link telegram">تيليجرام</a>
            <a href={`mailto:?subject=${encodeURIComponent(shareText)}&body=${encodeURIComponent('اطّلع على هذا التطبيق:\n' + pageUrl)}`} target="_blank" rel="noopener" class="share-link email">البريد الإلكتروني</a>
            <a href={`https://api.whatsapp.com/send?text=${encodeURIComponent(shareText + '\n' + pageUrl)}`} target="_blank" rel="noopener" class="share-link whatsapp">واتساب</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</PageLayout>

<style>
  .app-detail {
    max-width: 100%;
    margin: 0 auto;
  }

  .app-detail-header {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .back-link {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--color-accent-dark);
  }

  .app-detail-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .app-detail-main {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .app-detail-icon {
    width: clamp(3.5rem, 5vw, 5rem);
    height: clamp(4.5rem, 7vw, 6.5rem);
    background: #f0fdfa;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ccfbf1;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
  }

  .app-icon-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.5rem;
  }

  .app-detail-icon-symbol {
    font-size: clamp(2rem, 3vw, 2.8rem);
    line-height: 1;
  }

  .app-detail-title {
    font-family: var(--font-arabic-heading);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    color: var(--color-accent-dark);
    margin: 0 0 0.2rem 0;
    line-height: 1.3;
  }

  .app-detail-type {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    color: var(--color-text-light);
    margin: 0 0 0.8rem 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .featured-badge {
    font-size: 0.7rem;
    background: #fef3c7;
    color: #92400e;
    padding: 0.1rem 0.6rem;
    border-radius: 4px;
    border: 1px solid #f59e0b;
  }

  .app-detail-description {
    font-family: var(--font-arabic-body);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 2;
    color: var(--color-text);
    margin-bottom: clamp(1.2rem, 2vw, 1.8rem);
    padding: clamp(1rem, 2vw, 1.5rem);
    background: #f9fafb;
    border-radius: 6px;
    border-right: 4px solid var(--color-accent);
  }

  .app-detail-description p {
    margin: 0;
  }

  .app-detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: clamp(1.2rem, 2vw, 1.8rem);
  }

  .tags-label {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    color: var(--color-text-light);
    margin-left: 0.3rem;
  }

  .app-detail-tags .tag {
    font-family: var(--font-arabic-body);
    font-size: 0.75rem;
    background: #f0fdfa;
    color: var(--color-accent-dark);
    padding: 0.1rem 0.7rem;
    border-radius: 4px;
    border: 1px solid #ccfbf1;
  }

  .app-detail-note {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: clamp(1.2rem, 2vw, 1.8rem);
    padding: clamp(0.75rem, 1.5vw, 1rem) clamp(1rem, 2vw, 1.5rem);
    background: #f0fdfa;
    border-radius: 6px;
    border-right: 3px solid var(--color-accent);
    font-style: italic;
  }

  .app-detail-note p {
    margin: 0;
  }

  .app-detail-action {
    margin-top: clamp(0.5rem, 1vw, 1rem);
    padding-top: clamp(1rem, 2vw, 1.5rem);
    border-top: 1px solid var(--color-border);
  }

  .visit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: var(--color-accent);
    color: #ffffff;
    text-decoration: none;
    padding: clamp(0.7rem, 1.2vw, 0.9rem) clamp(1.5rem, 3vw, 2.5rem);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    font-weight: bold;
    border-radius: 8px;
    transition: background-color 0.2s, transform 0.1s;
    font-family: var(--font-arabic-heading);
    border: none;
  }

  .visit-btn:hover {
    background-color: var(--color-accent-dark);
    color: #ffffff;
  }

  .visit-btn:active {
    transform: scale(0.97);
  }

  .visit-icon {
    font-size: 1.2em;
    line-height: 1;
  }

  .visit-note {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.75rem, 1vw, 0.85rem);
    color: var(--color-text-light);
    margin: 0.4rem 0 0 0;
  }

  /* ─── Sidebar ─── */
  .app-detail-sidebar {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 2vw, 2rem);
  }

  .sidebar-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: clamp(1.25rem, 2vw, 1.75rem);
  }

  .sidebar-title {
    font-family: var(--font-arabic-heading);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--color-accent-dark);
    margin: 0 0 clamp(0.75rem, 1vw, 1rem) 0;
    border-bottom: 1px solid #e0f2f1;
    padding-bottom: 0.5rem;
  }

  .sidebar-info {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-info li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0;
    font-family: var(--font-arabic-body);
    font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    border-bottom: 1px solid #f3f4f6;
    gap: 0.5rem;
  }

  .sidebar-info li:last-child {
    border-bottom: none;
  }

  .info-label {
    color: var(--color-text-light);
    font-weight: 400;
  }

  .info-value {
    color: var(--color-text);
    font-weight: 500;
    text-align: left;
  }

  .sidebar-card-share {
    background: #f0fdfa;
    border-color: #ccfbf1;
  }

  .sidebar-share-text {
    font-family: var(--font-arabic-body);
    font-size: clamp(0.85rem, 1.2vw, 0.95rem);
    color: var(--color-text-light);
    margin: 0 0 0.75rem 0;
  }

  .share-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .share-link {
    font-family: var(--font-arabic-heading);
    font-size: clamp(0.8rem, 1vw, 0.9rem);
    padding: 0.3rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .share-link:hover {
    opacity: 0.8;
  }

  .share-link.telegram {
    background: #0088cc;
    color: #ffffff;
  }

  .share-link.email {
    background: #6c757d;
    color: #ffffff;
  }

  .share-link.whatsapp {
    background: #25d366;
    color: #ffffff;
  }

  @media (max-width: 800px) {
    .app-detail-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .app-detail-sidebar {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .sidebar-card {
      flex: 1;
      min-width: 200px;
    }
  }

  @media (max-width: 600px) {
    .app-detail-main {
      padding: 1rem;
    }

    .app-detail-description {
      padding: 0.75rem;
    }

    .app-detail-sidebar {
      flex-direction: column;
    }

    .sidebar-card {
      min-width: unset;
    }
  }
</style>